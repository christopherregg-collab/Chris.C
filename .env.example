# Copy to .env (gitignored) on the server and fill in. Never commit .env.

# BloFin API key with READ permission only (no Trade, no Transfer), bound to the server's IP.
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
BLOFIN_API_PASSPHRASE=

# Dashboard login (one user). Set these with deploy/set-login.sh, which asks for the
# password without showing it and stores only a salted scrypt hash.
DASHBOARD_EMAIL=
DASHBOARD_PASSWORD_HASH=
# Signs session cookies. Any long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# For local development only, a plain password works instead of the hash:
# DASHBOARD_PASSWORD=

# Optional: daily realized-loss cap in USDT, shown on the Risk card.
DAILY_LOSS_CAP=

# Optional overrides
# HOST=127.0.0.1
# PORT=3000
# SNAPSHOT_FILE=data/equity.jsonl

# Paper trader (scripts/paper-trader.js): API key created in BloFin's DEMO trading mode,
# with trade permission. Never a real-account key. See PAPER_TRADING.md.
BLOFIN_DEMO_API_KEY=
BLOFIN_DEMO_API_SECRET=
BLOFIN_DEMO_API_PASSPHRASE=

# LIVE trading (real money): a SEPARATE real-account key with Read + Trade permission, NO
# withdrawal, IP-bound to the server. Set up with deploy/go-live.sh. See LIVE_TRADING.md.
BLOFIN_TRADE_API_KEY=
BLOFIN_TRADE_API_SECRET=
BLOFIN_TRADE_API_PASSPHRASE=
LIVE_TRADING=off

# Which BloFin account the dashboard shows: real (default) or demo (the paper trader's account).
# Switch with: bash deploy/dashboard-account.sh demo|real
DASHBOARD_ACCOUNT=real
