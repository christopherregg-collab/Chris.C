# Copy to .env (gitignored) on the server and fill in. Never commit .env.

# BloFin API key with READ permission only (no Trade, no Transfer), bound to the server's IP.
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
BLOFIN_API_PASSPHRASE=

# Login for the dashboard (HTTP Basic auth). Use a long random password.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Optional: daily realized-loss cap in USDT, shown on the Risk card.
DAILY_LOSS_CAP=

# Optional overrides
# HOST=127.0.0.1
# PORT=3000
# SNAPSHOT_FILE=data/equity.jsonl
